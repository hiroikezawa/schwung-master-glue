{
  "id": "master-glue",
  "name": "MASTER GLUE",
  "abbrev": "GLUE",
  "version": "0.1.0",
  "description": "Clean stereo bus compressor and lookahead peak limiter for the Master FX: linked soft-knee RMS compression with sidechain HPF and AUTO release, then a sample-peak limiter. No saturation, no EQ on the audio.",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "master-glue.so",
  "component_type": "audio_fx",
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "audio_in": true,
    "audio_out": true,
    "midi_in": false,
    "midi_out": false,
    "chain_params": [
      {"key": "glue", "name": "Glue", "short_name": "GLUE", "type": "float", "min": 0, "max": 100, "step": 1, "default": 25, "unit": "%", "display_format": "%.0f"},
      {"key": "punch", "name": "Punch (Attack)", "short_name": "PUNCH", "type": "float", "min": 1, "max": 50, "step": 1, "default": 30, "unit": "ms", "display_format": "%.0f"},
      {"key": "release", "name": "Release", "short_name": "REL", "type": "enum", "options": ["AUTO", "50ms", "100ms", "150ms", "200ms", "300ms", "400ms", "600ms", "800ms", "1000ms"], "default": "AUTO"},
      {"key": "low_protect", "name": "Low Protect", "short_name": "LOWP", "type": "enum", "options": ["OFF", "40Hz", "60Hz", "80Hz", "90Hz", "100Hz", "120Hz", "150Hz", "200Hz"], "default": "100Hz"},
      {"key": "density", "name": "Density (Makeup)", "short_name": "DENS", "type": "float", "min": 0, "max": 12, "step": 0.1, "default": 0, "unit": "dB", "display_format": "%.1f"},
      {"key": "limit", "name": "Limit (Drive)", "short_name": "LIMIT", "type": "float", "min": 0, "max": 12, "step": 0.1, "default": 0, "unit": "dB", "display_format": "%.1f"},
      {"key": "ceiling", "name": "Ceiling", "short_name": "CEIL", "type": "float", "min": -6, "max": -0.3, "step": 0.1, "default": -1, "unit": "dB", "display_format": "%.1f"},
      {"key": "output", "name": "Output", "short_name": "OUT", "type": "float", "min": -24, "max": 0, "step": 0.1, "default": 0, "unit": "dB", "display_format": "%.1f"},
      {"key": "ratio", "name": "Ratio", "short_name": "RATIO", "type": "enum", "options": ["1.5:1", "2:1", "3:1", "4:1"], "default": "2:1"},
      {"key": "threshold", "name": "Threshold", "short_name": "THRSH", "type": "float", "min": -80, "max": 0, "step": 0.8, "default": -20, "unit": "dB", "display_format": "%.1f"},
      {"key": "knee", "name": "Knee", "short_name": "KNEE", "type": "float", "min": 0, "max": 12, "step": 0.5, "default": 6, "unit": "dB", "display_format": "%.1f"},
      {"key": "lim_release", "name": "Limiter Release", "short_name": "L.REL", "type": "float", "min": 20, "max": 500, "step": 5, "default": 100, "unit": "ms", "display_format": "%.0f"},
      {"key": "lookahead", "name": "Lookahead", "short_name": "LOOK", "type": "float", "min": 1, "max": 3, "step": 0.1, "default": 2, "unit": "ms", "display_format": "%.1f"},
      {"key": "comp_bypass", "name": "Comp Bypass", "short_name": "C.BYP", "type": "enum", "options": ["OFF", "ON"], "default": "OFF"},
      {"key": "lim_bypass", "name": "Limiter Bypass", "short_name": "L.BYP", "type": "enum", "options": ["OFF", "ON"], "default": "OFF"},
      {"key": "bypass", "name": "Bypass", "short_name": "BYP", "type": "enum", "options": ["OFF", "ON"], "default": "OFF"},
      {"key": "compare", "name": "Compare (Level Matched)", "short_name": "A/B", "type": "enum", "options": ["OFF", "ON"], "default": "OFF"},
      {"key": "in_peak", "name": "Input Peak", "short_name": "IN", "type": "float", "min": -60, "max": 0, "step": 0.1, "default": -60, "unit": "dB", "display_format": "%.1f", "access": "read"},
      {"key": "out_peak", "name": "Output Peak", "short_name": "OUT", "type": "float", "min": -60, "max": 0, "step": 0.1, "default": -60, "unit": "dB", "display_format": "%.1f", "access": "read"},
      {"key": "comp_gr", "name": "Comp Gain Reduction", "short_name": "COMP", "type": "float", "min": -24, "max": 0, "step": 0.1, "default": 0, "unit": "dB", "display_format": "%.1f", "access": "read"},
      {"key": "lim_gr", "name": "Limiter Gain Reduction", "short_name": "LIMIT", "type": "float", "min": -24, "max": 0, "step": 0.1, "default": 0, "unit": "dB", "display_format": "%.1f", "access": "read"}
    ],
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "MASTER GLUE",
          "knobs": ["glue", "punch", "release", "low_protect", "density", "limit", "ceiling", "output"],
          "params": ["glue", "punch", "release", "low_protect", "density", "limit", "ceiling", "output",
                     {"level": "advanced", "label": "Advanced"},
                     {"level": "meters", "label": "Meters"},
                     {"level": "presets", "label": "Presets"}]
        },
        "advanced": {
          "name": "Advanced",
          "knobs": ["ratio", "threshold", "knee", "lim_release", "lookahead", "comp_bypass", "lim_bypass", "bypass"],
          "params": ["ratio", "threshold", "knee", "lim_release", "lookahead", "comp_bypass", "lim_bypass", "bypass"]
        },
        "meters": {
          "name": "Meters",
          "knobs": ["in_peak", "out_peak", "comp_gr", "lim_gr", "compare"],
          "params": ["in_peak", "out_peak", "comp_gr", "lim_gr", "compare"]
        },
        "presets": {
          "name": "Presets",
          "list_param": "preset",
          "count_param": "preset_count",
          "name_param": "preset_name"
        }
      }
    }
  }
}
